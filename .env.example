# Copy to .env.local and fill in from Supabase > Project Settings > API.
# Both values are public by design; row level security protects the data.
# Leave them empty to use the official FootMax project. Set the URL to
# "off" to run the game guest-only, with no accounts.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
